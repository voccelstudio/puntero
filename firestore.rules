rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo puede leer/escribir sus propios datos
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Los documentos de estado pueden tener hasta 1 MB
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId
                          && request.resource.size < 1 * 1024 * 1024;
      }
    }

    // Workspace compartido: solo miembros pueden leer/escribir
    match /workspaces/{wsId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
                    && request.resource.data.members[0] == request.auth.uid;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members;
      allow delete: if request.auth != null
                    && resource.data.owner == request.auth.uid;
    }

    // DB Global de Contratistas: cualquier autenticado lee, cualquiera crea
    match /globalContractors/{conId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.addedBy == request.auth.uid;

      // Ratings individuales por usuario
      match /ratings/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Registro de cuentas del admin: lectura pública de datos SANITIZADOS
    // (sin contraseñas en claro; las demos guardan solo el hash).
    // La ESCRITURA exige la sesión del DUEÑO (por uid): es la única credencial
    // que no vive dentro del cliente. La identidad de transporte anterior
    // (admin.sync@puntero.local) quedó fuera a propósito — su contraseña estaba
    // escrita en el código fuente, que es público, y por lo tanto no era secreta.
    match /accounts/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
                                    && request.auth.uid == '6tF1PCIYwCZEhhf7lsDP7p5Ny6j1';
    }

    // Denegar todo lo demas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
