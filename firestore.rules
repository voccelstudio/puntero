rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo puede leer/escribir sus propios datos
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Los documentos de estado pueden tener hasta 1 MB
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId
                          && request.resource.size < 1 * 1024 * 1024;
      }
    }

    // Workspace compartido: solo miembros pueden leer/escribir
    match /workspaces/{wsId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
                    && request.resource.data.members[0] == request.auth.uid;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members;
      allow delete: if request.auth != null
                    && resource.data.owner == request.auth.uid;
    }

    // DB Global de Contratistas: cualquier autenticado lee, cualquiera crea
    match /globalContractors/{conId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.addedBy == request.auth.uid;

      // Ratings individuales por usuario
      match /ratings/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Registro de cuentas del admin: solo la identidad técnica de sincronización
    match /accounts/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == 'admin.sync@puntero.local';
    }

    // Denegar todo lo demas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
